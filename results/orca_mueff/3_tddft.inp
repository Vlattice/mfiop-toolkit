# STEP 3/3 - Electronic excited states (TD-DFT) of the tryptophan chromophore.
# Gives the 1La transition: energy, oscillator strength (fosc), transition dipole. KEY NUMBER.
# Run:  orca 3_tddft.inp > 3_tddft.out
! B3LYP def2-SVP D3BJ TightSCF
%maxcore 3000
%pal nprocs 4 end
%tddft
   nroots 10
   tda    false
end
* xyzfile 0 1 1_opt.xyz
