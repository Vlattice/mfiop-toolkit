NAME = 3_tddft.inp
|  1> # PASO 3/3 - Estados excitados (TD-DFT). Transicion 1La: energia + fosc. DATO CLAVE.
|  2> # CAM-B3LYP ordena bien 1La/1Lb en indol. Usa 1_opt.xyz del paso 1.
|  3> # Correr:  orca 3_tddft.inp > 3_tddft.out
|  4> ! CAM-B3LYP def2-SVP D3BJ TightSCF
|  5> %maxcore 3000
|  6> %pal nprocs 4 end
|  7> %tddft
|  8>    nroots 10
|  9>    tda    false
| 10> end
| 11> * xyzfile 0 1 1_opt.xyz
| 12> 
| 13>                          ****END OF INPUT****
